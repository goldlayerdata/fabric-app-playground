{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Revenue as columns and orders as a line, by year",
  "params": [{ "name": "highlight", "value": 0 }],
  "encoding": {
    "x": { "field": "dateYear", "type": "ordinal", "title": "Year" }
  },
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "y": { "field": "Revenue", "type": "quantitative", "title": "Revenue" },
        "color": { "datum": "Revenue" },
        "fillOpacity": {
          "condition": { "test": "highlight === 0 || datum.dateYear === highlight", "value": 1 },
          "value": 0.35
        }
      }
    },
    {
      "mark": { "type": "line", "point": true },
      "encoding": {
        "y": { "field": "Orders", "type": "quantitative", "title": "Orders" },
        "color": { "datum": "Orders" }
      }
    }
  ],
  "resolve": { "scale": { "y": "independent" } }
}
