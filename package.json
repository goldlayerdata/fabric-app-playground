{
  "name": "gold-layer-page-playground",
  "private": true,
  "version": "0.1.0",
  "description": "Gold Layer Fabric app playground: build a Fabric app one step at a time in TypeScript and React, with simulated data from the Contoso model. Unofficial, not affiliated with Microsoft.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "catalog": "node tools/make-catalog.mjs",
    "snapshots": "pwsh -NoProfile -File tools/snapshot.ps1",
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --serve",
    "preview": "node tools/serve-dist.mjs",
    "check": "node tools/check-lessons.mjs && node tools/check-visuals.mjs"
  },
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@griffel/react": "1.7.8",
    "@microsoft/fabric-datagrid": "1.0.0",
    "@microsoft/fabric-slicers": "4.4.0",
    "@microsoft/fabric-visuals": "1.0.0",
    "@microsoft/fabric-visuals-core": "1.0.0",
    "@tailwindcss/browser": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csstype": "3.2.4",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
